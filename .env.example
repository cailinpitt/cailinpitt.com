# Copy to .env and fill in. See RUNBOOK.md#credentials for where each value comes from.
# Cloudflare secrets (wrangler secret put) are write-only — .env is the only place
# a token can be read back from, so treat this as the copy of record.

# R2 — all image/photo scripts (images:*, photos:pull, photos:rm)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ORIGINALS_BUCKET=

# Bluesky — publish:atproto
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# BLUESKY_PDS=

# Last.fm — backfill-listening.mjs
LASTFM_API_KEY=
LASTFM_USER=

# Hardcover — reading:probe
HARDCOVER_TOKEN=

# Strava — moving:auth, moving:sync
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Ingest — saving articles
INGEST_TOKEN=

# Admin tokens — must match each Worker's ADMIN_TOKEN secret
READING_ADMIN_TOKEN=
WATCHING_ADMIN_TOKEN=
MOVING_ADMIN_TOKEN=
GUESTBOOK_ADMIN_TOKEN=
GUESTBOOK_IP_SALT=
COMMENTS_ADMIN_TOKEN=
COMMENTS_IP_SALT=

# Turnstile — guestbook and comment forms (same widget, both forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# worker-photos — phone uploads
WORKER_PHOTOS_INGEST_TOKEN=
WORKER_PHOTOS_GITHUB_TOKEN=

# Notes — must match worker-notes' PUBLISH_TOKEN secret
NOTES_PUBLISH_TOKEN=

# Overrides for pointing a script at a non-default Worker (optional)
# READING_API=
# WATCHING_API=
# MOVING_API=
# GUESTBOOK_API=
# COMMENTS_API=
# LISTENING_API=

# Build-time (Vite) — optional, all have production defaults baked into the code
# VITE_LISTENING_API=https://listening.cailinpitt.com
# VITE_READING_API=https://reading.cailinpitt.com
# VITE_WATCHING_API=https://watching.cailinpitt.com
# VITE_MOVING_API=https://moving.cailinpitt.com
# VITE_GUESTBOOK_API=https://guestbook.cailinpitt.com
# VITE_NOTES_API=https://notes.cailinpitt.com
# VITE_COMMENTS_API=https://comments.cailinpitt.com
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEEBNcQ83mO9Fcud
