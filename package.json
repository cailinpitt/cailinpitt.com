{
  "name": "cailinpitt-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs && node scripts/generate-markdown.mjs && node scripts/generate-rss.mjs && node scripts/generate-atproto.mjs && node scripts/generate-og.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:posts": "node scripts/migrate-posts.mjs",
    "migrate:images": "node scripts/download-images.mjs",
    "images:sync": "node scripts/sync-images.mjs",
    "photos:backfill": "node scripts/backfill-photo-dates.mjs",
    "photos:pull": "node scripts/pull-originals.mjs",
    "photos:rm": "node scripts/photos-rm.mjs",
    "images:check": "node scripts/sync-images.mjs --check",
    "images:upload": "node scripts/upload-r2.mjs",
    "images:prune": "node scripts/prune-r2.mjs",
    "images:publish": "npm run images:sync && npm run images:upload",
    "publish:atproto": "node scripts/publish-atproto.mjs",
    "reading:probe": "node scripts/hardcover-probe.mjs",
    "reading:sync": "node scripts/reading-sync.mjs",
    "guestbook:list": "node scripts/guestbook.mjs list",
    "guestbook:rm": "node scripts/guestbook.mjs rm",
    "md": "node scripts/generate-markdown.mjs",
    "og": "node scripts/generate-og.mjs",
    "rss": "node scripts/generate-rss.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite-react-ssg": "^0.9.1-beta.1"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.16",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "exif-reader": "^2.0.3",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.10",
    "xml2js": "^0.6.2"
  }
}
