{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cailinpitt-watching",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",

  // Read API on a subdomain of the (Cloudflare-managed) zone, same as the
  // listening and reading workers. Auto-provisions the DNS record + cert.
  "routes": [{ "pattern": "watching.cailinpitt.com", "custom_domain": true }],

  // Daily, matching worker-reading. Films change a few times a week at most, so
  // plenty of runs find nothing — but a run that finds nothing is nearly free
  // (one feed fetch, two D1 reads, no mirroring), and the alternative is a film
  // logged on Tuesday not showing up here until the following Monday.
  // 09:00 UTC ≈ 04:00 Central.
  "triggers": { "crons": ["0 9 * * *"] },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "vars": {
    // Fixed offset (seconds) used to decide which calendar year "this year"
    // means. -18000 = UTC-5 (US Central, DST); -21600 for standard time.
    // Matches the other two workers — see worker/README.md on the DST caveat.
    // Nothing else needs it: Letterboxd logs a date, not a timestamp.
    "TZ_OFFSET_SECONDS": "-18000",
    // Comma-separated origins allowed to read the API (CORS). Any http://localhost
    // or 127.0.0.1 port is additionally allowed in code, so local dev needs no
    // entry here. The first entry is the fallback sent to non-matching origins.
    "ALLOWED_ORIGIN": "https://cailinpitt.com",
    // The Letterboxd member whose diary feed is pulled. A var rather than a
    // secret: it is half of a URL anyone can open.
    "LETTERBOXD_USER": "ticketmasterceo",
    // Posters mirrored per run. A free-plan invocation gets 50 subrequests
    // (R2/D1 binding calls included) and each mirror costs 2; the rest of a run
    // spends ~6. Whatever is left over is picked up by the next run. On Workers
    // Paid (10,000 subrequests) raise this past the archive size and the whole
    // backfill mirrors in a single pass.
    "MIRROR_BUDGET": "15"
  },

  // Bindings.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cailinpitt-watching",
      "database_id": "204b2150-5529-4955-9813-11ebe92c98df"
    }
  ],

  // The same bucket the photo galleries and book covers use, bound directly (no
  // S3 credentials). Posters are mirrored under images/watching/.
  //
  // preview_bucket_name is the *same* bucket on purpose, matching
  // worker-reading: `wrangler dev --remote` refuses to start without it, and
  // the initial poster backfill is run that way, so it has to land in the
  // bucket the site actually serves. Safe because keys are content-addressed (a
  // SHA-256 of the source url) and uploaded immutable, so a dev run can only
  // ever rewrite a key with the same bytes.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "cailinpitt-photos",
      "preview_bucket_name": "cailinpitt-photos"
    }
  ]

  // Secrets (not stored here):
  //   wrangler secret put ADMIN_TOKEN
}
