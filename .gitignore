# Local-only planning + agent files
plan.md
.claude/

# Dependencies / build
node_modules/
dist/
*.local

# Cloudflare Worker build/runtime artifacts + local secrets, for every worker-*/
worker-*/.wrangler/
worker-*/.dev.vars

# Hand-off file between the two halves of scripts/ingest-photos.mjs, written and
# deleted inside a single CI run.
.ingest-queue.json
scripts/backfill.sql
scripts/backfill.sql.progress.json

# Logs
npm-debug.log*
*.log

# Migration inputs / backups (large, not part of the site source)
squarespace-export.xml
squarespace-backup/

# Images — ALL images (blog + galleries) are served from Cloudflare R2, never
# committed, to keep the repo small. Local copies under public/images are working
# copies; push them to R2 with `npm run images:upload`.
/public/images/

# Camera originals. Purely a local working directory: `npm run images:sync` reads
# these and writes the web-sized renditions into public/images/. Never committed,
# never uploaded, never built into the site.
/originals/

# Local env (R2 credentials, image base URL, etc.)
.env
.env.local

# OS
.DS_Store

# Generated by scripts/watching-backfill.mjs — a one-off import and its slug cache.
scripts/watching-backfill.sql
scripts/.watching-slugs.json

# Generated from the Strava bulk export; re-derivable, and thousands of lines.
# scripts/moving-recategorize.sql is hand-written and *is* tracked.
scripts/moving-backfill.sql

# Completed listening periods, baked from the API at build time by
# scripts/bake-listening.mjs. Generated, immutable, and re-fetchable — the client
# falls back to the API when a file is absent, so these never belong in git.
/public/listening-data/

# Generated by scripts/enrich-listening.mjs — 16 MB of upserts, regenerable from
# the Last.fm API, and loaded into D1 once. Same rule as scripts/backfill.sql.
/scripts/enrich.sql
/scripts/enrich.sql.progress.json
/scripts/musicbrainz.sql
/scripts/musicbrainz.sql.progress.json
/scripts/musicbrainz.review.txt
