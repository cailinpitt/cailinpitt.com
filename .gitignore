# Local-only planning + agent files
plan.md
.claude/

# Dependencies / build
node_modules/
dist/
*.local

# Cloudflare Worker (listening API) build/runtime artifacts
worker/.wrangler/
worker/.dev.vars
scripts/backfill.sql
scripts/backfill.sql.progress.json

# Logs
npm-debug.log*
*.log

# Migration inputs / backups (large, not part of the site source)
squarespace-export.xml
squarespace-backup/

# Images — ALL images (blog + galleries) are served from Cloudflare R2, never
# committed, to keep the repo small. Local copies under public/images are working
# copies; push them to R2 with `npm run images:upload`.
/public/images/

# Camera originals. Purely a local working directory: `npm run images:sync` reads
# these and writes the web-sized renditions into public/images/. Never committed,
# never uploaded, never built into the site.
/originals/

# Local env (R2 credentials, image base URL, etc.)
.env
.env.local

# OS
.DS_Store
